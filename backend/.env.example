PORT=3000
NODE_ENV=development
DB_ADDRESS=mongodb://127.0.0.1:27017/weblarek
# Для Docker: mongodb://root:example@mongo:27017/weblarek?authSource=admin
UPLOAD_PATH=images
UPLOAD_PATH_TEMP=temp
MAX_FILE_SIZE=5242880
TEMP_FILE_MAX_AGE=1d
TEMP_CLEANUP_CRON=0 * * * *
ORIGIN_ALLOW=http://localhost:5173
AUTH_ACCESS_TOKEN_EXPIRY=10m
AUTH_REFRESH_TOKEN_EXPIRY=7d
# Сгенерируйте два разных ключа: openssl rand -hex 32
AUTH_ACCESS_TOKEN_SECRET=
AUTH_REFRESH_TOKEN_SECRET=
COOKIE_SECURE=false
